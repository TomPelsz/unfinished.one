---
import Entry from '../../../../components/Entry.astro';
import { loadAllComponents } from '../../../../lib/data';

export function getStaticPaths() {
  return loadAllComponents().flatMap((c) =>
    c.versions.filter((v: any) => v.status !== 'withdrawn').map((entry: any) => ({ params: { id: c.id, version: entry.version }, props: { entry, versions: c.versions.map((v: any) => v.version), withdrawn: c.latest.status === 'withdrawn' ? c.latest : undefined } })),
  );
}
const { entry, versions, withdrawn } = Astro.props;
---
<Entry entry={entry} versions={versions} pinned={true} withdrawn={withdrawn} />
