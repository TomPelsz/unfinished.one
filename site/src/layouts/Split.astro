---
// Two-column page: a list on the left (passed in the "side" slot), the page on the right.
// On narrow screens the list folds into a panel above the page, labelled by `fold`.
import Base from './Base.astro';
interface Props { title: string; description?: string; canonical?: string; noindex?: boolean; fold?: string }
const { fold = 'Browse', ...base } = Astro.props;
---
<Base {...base} wide>
  <slot name="head" slot="head" />
  <div class="split">
    <aside class="split-side">
      <details class="split-fold" data-splitfold open>
        <summary>{fold}</summary>
        <slot name="side" />
      </details>
    </aside>
    <div class="split-main"><slot /></div>
  </div>
  <script is:inline>
    // The list starts open (so it shows without scripts); on narrow screens it folds away.
    (() => {
      const fold = document.querySelector('[data-splitfold]');
      const wide = matchMedia('(min-width: 880px)');
      const sync = () => { fold.open = wide.matches; };
      sync();
      wide.addEventListener('change', sync);
    })();
  </script>
  <style>
    .split { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 40px; align-items: start; }
    .split-side { position: sticky; top: 16px; }
    .split-fold > summary { display: none; }
    .split-fold > :global(nav) { max-height: calc(100vh - 32px); }
    .split-main { min-width: 0; max-width: 820px; }
    .split-main > :global(h1:first-child), .split-main > :global(p:first-child) { margin-top: 0; }
    @media (max-width: 879px) {
      .split { grid-template-columns: minmax(0, 1fr); gap: 16px; }
      .split-side { position: static; }
      .split-fold { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
      .split-fold > summary { display: list-item; cursor: pointer; color: var(--accent); font-size: 15px; }
      .split-fold[open] > summary { margin-bottom: 8px; }
      .split-fold > :global(nav) { max-height: 60vh; }
    }
  </style>
</Base>
