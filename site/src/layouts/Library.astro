---
// The library: the component list on the left, the page on the right.
import Split from './Split.astro';
import LibraryNav from '../components/LibraryNav.astro';
interface Props { title: string; description?: string; canonical?: string; noindex?: boolean; current?: string }
const { current, ...base } = Astro.props;
---
<Split {...base} fold="Browse components">
  <slot name="head" slot="head" />
  <LibraryNav slot="side" current={current} />
  <slot />
</Split>
