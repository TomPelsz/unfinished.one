---
// Header search across components, municipalities and pages. The index (/search.json) loads on first
// focus; "/" focuses the box from anywhere, arrow keys move through results, Enter opens one.
---
<div class="sitesearch" data-sitesearch>
  <label class="visually-hidden" for="sitesearch-q">Search the library</label>
  <input id="sitesearch-q" type="search" placeholder="Search" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="sitesearch-list" aria-autocomplete="list" />
  <kbd aria-hidden="true">/</kbd>
  <ul id="sitesearch-list" role="listbox" hidden></ul>
</div>
<script is:inline>
  (() => {
    const box = document.querySelector('[data-sitesearch]');
    if (!box) return;
    const q = box.querySelector('input');
    const list = box.querySelector('ul');
    let index = null, loading = null, results = [], active = -1;
    const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9.]+/g, ' ').trim();
    const load = () => (loading ??= fetch('/search.json').then((r) => r.json()).then((d) => {
      index = d.map((x) => ({ ...x, nt: norm(x.t), nk: norm(x.k) }));
      if (q.value) render();
    }).catch(() => { loading = null; }));
    // Title prefix beats a word in the title, which beats an alias or code; every word must match somewhere.
    const score = (x, words) => {
      let s = 0;
      for (const w of words) {
        if (x.nt.startsWith(w)) s += 4;
        else if ((' ' + x.nt).includes(' ' + w)) s += 3;
        else if (x.nt.includes(w)) s += 2;
        else if ((' ' + x.nk).includes(' ' + w)) s += 1.5;
        else if (x.nk.includes(w)) s += 1;
        else return 0;
      }
      return s - x.nt.length / 1000;
    };
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const render = () => {
      const words = norm(q.value).split(' ').filter(Boolean);
      results = !index || !words.length ? [] : index.map((x) => [score(x, words), x]).filter(([s]) => s > 0).sort((a, b) => b[0] - a[0]).slice(0, 8).map(([, x]) => x);
      active = results.length ? 0 : -1;
      list.innerHTML = results.length
        ? results.map((x, i) => `<li role="option" id="ss-${i}" aria-selected="${i === active}"><a href="${x.u}"><span class="t">${esc(x.t)}</span><span class="s">${esc(x.s)}</span></a></li>`).join('')
        : words.length ? `<li class="none">${index ? 'Nothing matches.' : 'Loading…'}</li>` : '';
      list.hidden = !words.length;
      q.setAttribute('aria-expanded', String(!list.hidden));
      q.setAttribute('aria-activedescendant', active >= 0 ? `ss-${active}` : '');
    };
    const move = (d) => {
      if (!results.length) return;
      active = (active + d + results.length) % results.length;
      list.querySelectorAll('[role=option]').forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
      list.querySelector(`#ss-${active}`)?.scrollIntoView({ block: 'nearest' });
      q.setAttribute('aria-activedescendant', `ss-${active}`);
    };
    q.addEventListener('focus', () => { load(); if (q.value) render(); });
    q.addEventListener('input', render);
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter' && results[active]) { e.preventDefault(); location.href = results[active].u; }
      else if (e.key === 'Escape') { if (q.value) { q.value = ''; render(); } else q.blur(); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target;
      if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      e.preventDefault();
      q.focus();
      q.select();
    });
    document.addEventListener('click', (e) => { if (!box.contains(e.target)) { list.hidden = true; q.setAttribute('aria-expanded', 'false'); } });
  })();
</script>
<style is:global>
  .sitesearch { position: relative; flex: 1 1 200px; max-width: 340px; }
  .sitesearch input { width: 100%; padding: 6px 30px 6px 10px; font: inherit; font-size: 15px; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; }
  .sitesearch input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); outline-offset: 0; border-color: var(--accent); }
  .sitesearch kbd { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font: 12px/1 ui-monospace, monospace; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 2px 5px; pointer-events: none; }
  .sitesearch input:focus + kbd, .sitesearch input:not(:placeholder-shown) + kbd { display: none; }
  .sitesearch ul { position: absolute; z-index: 20; top: calc(100% + 4px); left: 0; right: 0; min-width: 280px; max-height: 70vh; overflow-y: auto; list-style: none; margin: 0; padding: 4px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 8px 24px rgb(0 0 0 / 0.12); }
  .sitesearch li { margin: 0; }
  .sitesearch li a { display: block; padding: 6px 8px; border-radius: 5px; color: var(--fg); text-decoration: none; }
  .sitesearch li[aria-selected='true'] a, .sitesearch li a:hover { background: color-mix(in srgb, var(--accent) 16%, transparent); }
  .sitesearch .t { display: block; font-size: 15px; line-height: 1.3; }
  .sitesearch .s { display: block; font-size: 12px; color: var(--muted); }
  .sitesearch .none { padding: 8px; font-size: 14px; color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 640px) { .sitesearch { order: 3; flex-basis: 100%; max-width: none; } }
</style>
