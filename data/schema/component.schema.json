{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfinished.one/schema/component.schema.json",
  "title": "unfinished.one component entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "classification",
    "names",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uniformat"
      ],
      "properties": {
        "uniformat": {
          "type": "string"
        },
        "omniclass": {
          "type": "string"
        }
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_life": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median_years",
        "range_years"
      ],
      "properties": {
        "median_years": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "range_years": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factor",
              "effect_years"
            ],
            "properties": {
              "factor": {
                "type": "string"
              },
              "effect_years": {
                "type": "number"
              }
            }
          }
        },
        "range_basis": {
          "enum": [
            "p10_p90",
            "source_spread"
          ],
          "description": "p10_p90 (the default): 80% of units last between the two values. source_spread: the shortest and longest life stated by the sources in basis; it says how much sources disagree, not how long units last."
        }
      }
    },
    "pm_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "frequency"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "frequency": {
            "type": "string",
            "pattern": "^P(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?$"
          },
          "trade": {
            "type": "string"
          },
          "labour_h": {
            "type": "number",
            "minimum": 0
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "description": "Only when a source states it; never inferred."
          },
          "reference": {
            "type": "string",
            "description": "Short citation of the source, e.g. its title"
          },
          "url": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Physical PDF page the task is on"
          },
          "checklist": {
            "type": "string",
            "description": "The source's checklist or table title"
          }
        }
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "public_document",
              "manufacturer",
              "standard_reference",
              "observed_data",
              "open_research",
              "expert_estimate"
            ]
          },
          "life_type": {
            "enum": [
              "accounting",
              "planning",
              "design",
              "observed"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "The source's own row or clause number, e.g. HUD CNA 3.4.1.2.6"
          },
          "label": {
            "type": "string",
            "description": "The row label exactly as the source prints it"
          },
          "years": {
            "description": "The life the source states for this row: a number, or [min, max] for a range",
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Physical PDF page the row is on"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade"
      ],
      "properties": {
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "sample_size": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "withdrawn"
      ],
      "description": "Set on a version that withdraws the entry: no source supports a value any more. Earlier versions stay at their permanent links."
    },
    "withdrawn_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "withdrawn"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "withdrawn_reason"
    ],
    "not": {
      "anyOf": [
        {
          "required": [
            "service_life"
          ]
        },
        {
          "required": [
            "basis"
          ]
        },
        {
          "required": [
            "confidence"
          ]
        }
      ]
    }
  },
  "else": {
    "required": [
      "service_life",
      "pm_tasks",
      "basis",
      "confidence",
      "open_questions"
    ]
  }
}
